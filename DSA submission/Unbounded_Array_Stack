public class UnboundedArrayStack {
    private int[] arr;
    private int top;
    private int capacity;

    public UnboundedArrayStack() {
        capacity = 2;
        arr = new int[capacity];
        top = -1;
    }

    public void push(int x) {
        if (top + 1 == capacity) {
            resize(capacity * 2); // double
        }
        arr[++top] = x;
    }

    public int pop() {
        if (isEmpty()) {
            System.out.println("Stack is empty");
            return -1;
        }
        int val = arr[top--];
        // 1/4 ta adu unoth, half karanawa
        if (top + 1 <= capacity / 4 && capacity > 2) {
            resize(capacity / 2);
        }
        return val;
    }

    private void resize(int newCapacity) {
        int[] newArr = new int[newCapacity];
        for (int i = 0; i <= top; i++) {
            newArr[i] = arr[i];
        }
        arr = newArr;
        capacity = newCapacity;
        System.out.println("Resized to: " + capacity);
    }

    public int peek() {
        if (isEmpty()) return -1;
        return arr[top];
    }

    public boolean isEmpty() {
        return top == -1;
    }

    public int size() {
        return top + 1;
    }

    public static void main(String[] args) {
        UnboundedArrayStack s = new UnboundedArrayStack();
        s.push(10); s.push(20); s.push(30); // resize to 4
        s.push(40); s.push(50); // resize to 8
        System.out.println(s.pop()); // 50
        System.out.println(s.pop()); // 40
    }
}